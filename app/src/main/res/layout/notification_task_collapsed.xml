<?xml version="1.0" encoding="utf-8"?>
<!-- Compact notification body; Android supplies its normal app header and controls.
     Keep the layout at 48dp or less for Android 12+ collapsed notification limits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/notification_task_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingEnd="8dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:contentDescription="Open task" />

    <TextView
        android:id="@+id/notification_done"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:minWidth="72dp"
        android:gravity="center"
        android:background="@drawable/notification_done_background"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Mark task done"
        android:text="✓ Done"
        android:textColor="#142034"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingStart="11dp"
        android:paddingEnd="11dp" />
</LinearLayout>
